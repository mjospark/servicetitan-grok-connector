{
  "name": "servicetitan-grok-connector",
  "version": "1.0.0",
  "description": "Free Grok Bot marketplace plugin + paid hosted ServiceTitan MCP bridge for trade businesses",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "st-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-fixtures.mjs",
    "start:mcp": "node dist/mcp/server.js",
    "start:web": "node dist/web/server.js",
    "dev:mcp": "tsx src/mcp/server.ts",
    "dev:web": "tsx src/web/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx scripts/smoke.ts",
    "gen-fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "servicetitan",
    "mcp",
    "grok-bot",
    "field-service",
    "electrician"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2",
    "express": "^4.21.2",
    "stripe": "^17.7.0",
    "nanoid": "^5.1.5",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
