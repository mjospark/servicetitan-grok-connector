# === Mode ===
# MOCK=1 → fixture data, no ServiceTitan or Stripe needed (default for local)
MOCK=1

# === ServiceTitan API (needed when MOCK=0) ===
# Get these from https://developer.servicetitan.io / partner app signup
SERVICE_TITAN_CLIENT_ID=
SERVICE_TITAN_CLIENT_SECRET=
SERVICE_TITAN_TENANT_ID=
SERVICE_TITAN_APP_KEY=

# === License / monetization ===
# For self-host without Stripe: set a static key customers get after paying you manually
LICENSE_KEY=
# Or path to license store (JSON) written by the web signup server
LICENSE_STORE_PATH=./data/licenses.json

# === Stripe (test mode only until you flip live — see NAP_BRIEFING.md) ===
# Create a free Stripe account yourself; use TEST keys. Never put live secret keys in git.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=price_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Public URL of this web server (for Checkout success/cancel + webhook)
PUBLIC_BASE_URL=http://localhost:8787

# === Zero-Stripe paid checkout (recommended if you already sell on Gumroad/Whop) ===
# Paste your $49 product checkout URL. Pro button redirects there — no Stripe keys.
# Example: https://mjospark.gumroad.com/l/YOUR-PRODUCT
PAID_CHECKOUT_URL=

# === Web server ===
WEB_PORT=8787
MCP_PORT=8788
